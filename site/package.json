{
  "name": "loliland-team-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:local": "vite --mode emulators",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-loliland",
    "test:rules": "firebase emulators:exec --only firestore --project demo-loliland-rules \"node --test tests/rules.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting,firestore",
    "test:unit": "node --test tests/catalog.test.ts tests/plan.test.ts",
    "test": "npm run test:unit && npm run test:rules"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-tools": "^15.36.0",
    "globals": "^16.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
